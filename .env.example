# ==============================================================================
# FLASHCARD APPLICATION - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the project root:
#      cp .env.example .env
#    (On Windows PowerShell: Copy-Item .env.example .env)
# 2. Update database connection strings and API keys as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Connection string for Prisma Client with connection pooling (e.g. PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flashcard?schema=public"

# DIRECT_URL:
# Direct connection string for Prisma migrations, db push, and schema validation (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/flashcard?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# NEXTAUTH_URL:
# The canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET:
# Secret key used to sign and encrypt JWT session tokens (min 32 characters)
NEXTAUTH_SECRET="flashcard-development-secret-key-must-be-at-least-32-chars-long!"

# AUTH_SECRET (Optional fallback for NEXTAUTH_SECRET):
AUTH_SECRET="flashcard-development-secret-key-must-be-at-least-32-chars-long!"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH PROVIDER (Optional for local development)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (For AI card generation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT / RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
